{
  "radio_address": "meshcore-radio.local:8001",
  "radio": {"FreqHz": 910525000, "BwHz": 62500, "SF": 7, "CR": 5},
  "tx_power": 22,
  "require_parity": true,
  "phy_authority": "host",
  "radio_session": "auto",
