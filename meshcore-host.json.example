  "companion_listen": "127.0.0.1:5000",
  "companion_allow_remote": false,
  "bot_listen": "127.0.0.1:8105",
  "bot_max_clients": 2,
  "status_listen": "127.0.0.1:9080",
  "repeater_name": "Shared Radio Repeater",
  "room_name": "Shared Radio Room",
  "companion_name": "Shared Radio Base",
  "room_password": "",
  "room_password_env": "MESHCORE_ROOM_PASSWORD",
  "room_public": false,
  "admin_password_env": "",
  "repeater_policy": {"path_hash_mode": 2},
  "room_policy": {"path_hash_mode": 2},
  "companion_policy": {"path_hash_mode": 2},
  "bot_companion_policy": {"path_hash_mode": 2},
  "companion_retention": "durable_replay",
