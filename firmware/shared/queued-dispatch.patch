+bool Dispatcher::submitQueued(Packet* packet, uint8_t priority, uint32_t delay) {
+  if (packet->_localReflection || !_radio->queuedReady()) return false;
+  for (auto& entry : queued_packets) {
+    if (entry.packet) continue;
+    uint8_t raw[MAX_TRANS_UNIT];
+    const int length = packet->getRawLength();
+    if (length < 2 || length > MAX_TRANS_UNIT) return false;
+    int n = 0;
+    raw[n++] = packet->header;
+    if (packet->hasTransportCodes()) {
+      memcpy(raw + n, packet->transport_codes, 4); n += 4;
+    }
+    raw[n++] = packet->path_len;
+    n += Packet::writePath(raw + n, packet->path, packet->path_len);
+    memcpy(raw + n, packet->payload, packet->payload_len);
+    if (!_radio->queueTransmit(raw, length, priority, delay, 0,
+                               entry.job)) return false;
+    entry.packet = packet;
+    return true;
+  }
+  _err_flags |= ERR_EVENT_FULL;
+  return false;
+}
+
+void Dispatcher::completeQueued() {
+  QueuedTransmitResult result;
+  while (_radio->pollQueuedResult(result)) {
+    for (auto& entry : queued_packets) {
+      if (!entry.packet || entry.job != result.job) continue;
+      logQueuedTxResult(entry.packet, result);
+      if (result.state == 1) break; // Admission is not RF completion.
+      if (result.has_rf_ms) total_air_time += result.rf_ms;
+      if (result.state == 2) {
+        logTx(entry.packet, entry.packet->getRawLength());
+        if (entry.packet->isRouteFlood()) ++n_sent_flood;
+        else ++n_sent_direct;
+      } else {
+        logTxFail(entry.packet, entry.packet->getRawLength());
+      }
+      _mgr->free(entry.packet);
+      entry.packet = nullptr;
+      break;
+    }
+  }
+}
