diff --git a/src/helpers/radiolib/CustomSX1262Wrapper.h b/src/helpers/radiolib/CustomSX1262Wrapper.h
--- a/src/helpers/radiolib/CustomSX1262Wrapper.h
+++ b/src/helpers/radiolib/CustomSX1262Wrapper.h
@@ -13,6 +13,8 @@ public:
   CustomSX1262Wrapper(CustomSX1262& radio, mesh::MainBoard& board) : RadioLibWrapper(radio, board) { }
 
   void setParams(float freq, float bw, uint8_t sf, uint8_t cr) override {
+    // Leave cached RX state so recvRaw restarts reception with the new settings.
+    idle();
     ((CustomSX1262 *)_radio)->setFrequency(freq);
     ((CustomSX1262 *)_radio)->setSpreadingFactor(sf);
     ((CustomSX1262 *)_radio)->setBandwidth(bw);
diff --git a/src/helpers/radiolib/RadioLibWrappers.cpp b/src/helpers/radiolib/RadioLibWrappers.cpp
--- a/src/helpers/radiolib/RadioLibWrappers.cpp
+++ b/src/helpers/radiolib/RadioLibWrappers.cpp
@@ -57,6 +57,7 @@ void RadioLibWrapper::setTxPower(int8_t dbm) {
+  idle();
   _radio->setOutputPower(dbm);
 }
 
 void RadioLibWrapper::idle() {
   _radio->standby();
   state = STATE_IDLE;   // need another startReceive()
diff --git a/src/helpers/radiolib/SX126xReset.h b/src/helpers/radiolib/SX126xReset.h
--- a/src/helpers/radiolib/SX126xReset.h
+++ b/src/helpers/radiolib/SX126xReset.h
@@ -1,37 +1,29 @@
 #pragma once
 
 #include <RadioLib.h>
+#include "MeshCore.h"
 
-// Full receiver reset for all SX126x-family chips (SX1262, SX1268, LLCC68, STM32WLx).
-// Warm sleep powers down analog, Calibrate(0x7F) refreshes ADC/PLL/image calibration,
-// then re-applies RX settings that calibration may reset.
+// Use RadioLib's checked sleep/wake and calibration sequence. Do not continue
+// issuing SPI commands after a failed reset stage.
 inline void sx126xResetAGC(SX126x* radio, bool rx_boost_gain) {
-  radio->sleep(true);
-  radio->standby(RADIOLIB_SX126X_STANDBY_RC, true);
-
-  uint8_t calData = RADIOLIB_SX126X_CALIBRATE_ALL;
-  radio->mod->SPIwriteStream(RADIOLIB_SX126X_CMD_CALIBRATE, &calData, 1, true, false);
-  radio->mod->hal->delay(5);
-  uint32_t start = millis();
-  while (radio->mod->hal->digitalRead(radio->mod->getGpio())) {
-    if (millis() - start > 50) break;
-    radio->mod->hal->yield();
-  }
-
-  // Calibrate(0x7F) defaults image calibration to 902-928MHz band.
-  // Re-calibrate for the actual operating frequency.
-  radio->calibrateImage(radio->freqMHz);
-
-#ifdef SX126X_DIO2_AS_RF_SWITCH
-  radio->setDio2AsRfSwitch(SX126X_DIO2_AS_RF_SWITCH);
-#endif
+  int16_t status = radio->resetAGC();
 #ifdef SX126X_RX_BOOSTED_GAIN
-  radio->setRxBoostedGainMode(rx_boost_gain);
+  // RadioLib restores enabled gain from its cache; preserve disabled gain too.
+  if (status == RADIOLIB_ERR_NONE && !rx_boost_gain)
+    status = radio->setRxBoostedGainMode(false);
+#else
+  (void)rx_boost_gain;
 #endif
 #ifdef SX126X_REGISTER_PATCH
-  uint8_t r_data = 0;
-  radio->readRegister(0x8B5, &r_data, 1);
-  r_data |= 0x01;
-  radio->writeRegister(0x8B5, &r_data, 1);
+  if (status == RADIOLIB_ERR_NONE) {
+    uint8_t data = 0;
+    status = radio->readRegister(0x8B5, &data, 1);
+    if (status == RADIOLIB_ERR_NONE) {
+      data |= 0x01;
+      status = radio->writeRegister(0x8B5, &data, 1);
+    }
+  }
 #endif
+  if (status != RADIOLIB_ERR_NONE)
+    MESH_DEBUG_PRINTLN("SX126x AGC reset failed (error %d); reception will retry", int(status));
 }
