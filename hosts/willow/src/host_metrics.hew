//! Bounded Prometheus projection of existing public health snapshots.
import std.encoding.json;

fn field(value: json.Value, key: string) -> Option<json.Value> {
    match value.get_field(key) { .Ok(item) => item, .Err(_) => .None, }
}
fn flag(value: json.Value, key: string) -> Option<bool> {
    if let .Some(item) = field(value, key) {
        if let .Ok(result) = item.get_bool() { return .Some(result); }
    }
    .None
}
fn enabled(value: json.Value, key: string) -> bool {
    match flag(value, key) { .Some(result) => result, .None => false, }
}
fn sample(name: string, labels: string, value: f64) -> string {
    if !value.is_finite() { return ""; }
    f"{name}{labels} {value}\n"
}
fn boolean(name: string, labels: string, value: Option<bool>) -> string {
    if let .Some(flag) = value { return sample(name, labels, if flag { 1.0 } else { 0.0 }); }
    ""
}
fn numeric(name: string, labels: string, value: json.Value, key: string, scale: f64) -> string {
    if let .Some(item) = field(value, key) {
        if let .Ok(integer) = item.get_int() { return sample(name, labels, (integer as f64) * scale); }
        if let .Ok(number) = item.get_float() { return sample(name, labels, number * scale); }
    }
    ""
}
fn text(value: json.Value, key: string) -> string {
    if let .Some(item) = field(value, key) {
        if let .Ok(result) = item.get_string() { return result; }
    }
    ""
}
fn label(value: string) -> string {
    value.replace("\\", "\\\\").replace("\n", "\\n").replace("\"", "\\\"")
}
fn identifier(value: string) -> bool {
    if value.is_empty() || value.len() > 23 { return false; }
    let data = value.to_bytes();
    for i in 0..data.len() {
        let b = data[i];
        if !((b >= 97 && b <= 122) || (i > 0 && (b == 95 || (b >= 48 && b <= 57)))) { return false; }
    }
    true
}
fn member(value: json.Value, key: string) -> json.Value {
    match field(value, key) { .Some(item) => item, .None => json.null(), }
}
fn count(value: json.Value, limit: i64) -> i64 {
    match value.array_len() { .Ok(n) => if n < limit { n } else { limit } .Err(_) => 0, }
}
fn at(value: json.Value, index: i64) -> json.Value {
    match value.array_get(index) {
        .Ok(item) => match item { .Some(v) => v, .None => json.null(), }
        .Err(_) => json.null(),
    }
}
fn packet_reports(bot: json.Value) -> string {
    let key = text(bot, "public_key");
    if key.len() != 64 { return ""; }
    let device = label("willow_" + key[0..16]);
    let reports = member(bot, "packet_reports");
    var out = "";
    for i in 0..count(reports, 2) {
        let report = at(reports, i);
        let name = text(report, "name");
        if !identifier(name) { continue; }
        let slot = match member(report, "slot").get_int() { .Ok(n) => n, .Err(_) => -1, };
        if slot < 0 || slot > 1 { continue; }
        let fields = member(report, "fields");
        let rows = member(report, "rows");
        for r in 0..count(rows, 16) {
            let row = at(rows, r);
            let hop = label(text(row, "label"));
            let labels = f"\{device=\"{device}\",slot=\"{slot}\",report=\"{name}\",label=\"{hop}\"\}";
            let values = member(row, "values");
            for f in 0..count(fields, count(values, 8)) {
                let metric = match at(fields, f).get_string() { .Ok(v) => v, .Err(_) => "", };
                if !identifier(metric) { continue; }
                let value = at(values, f);
                if let .Ok(integer) = value.get_int() { out += sample("meshcore_packet_" + metric, labels, integer as f64); }
                else if let .Ok(number) = value.get_float() { out += sample("meshcore_packet_" + metric, labels, number); }
            }
        }
    }
    out
}

pub fn render(status: json.Value, ready: json.Value) -> string {
    var out = "# HELP willow_role_health_available Role status was returned by its health source.\n# TYPE willow_role_health_available gauge\n# TYPE willow_role_ready gauge\n# TYPE willow_role_running gauge\n# TYPE willow_radio_connected gauge\n# TYPE willow_companion_listener_active gauge\n# TYPE willow_observer_mqtt_connected gauge\n# TYPE willow_observer_observed_total counter\n# TYPE willow_observer_published_total counter\n# TYPE willow_observer_dropped_total counter\n# TYPE willow_observer_queued gauge\n# TYPE willow_observer_pending gauge\n# TYPE willow_observer_dirty gauge\n# TYPE willow_observer_saving gauge\n# TYPE willow_observer_save_failures_total counter\n# TYPE willow_observer_save_error gauge\n# TYPE willow_observer_restored gauge\n# TYPE willow_observer_expired_total counter\n# TYPE willow_role_tx_accepted_total counter\n# TYPE willow_role_tx_succeeded_total counter\n# TYPE willow_role_tx_failed_total counter\n# TYPE willow_role_tx_rejected_total counter\n# TYPE willow_role_tx_unknown_total counter\n# TYPE willow_role_tx_diagnostic_drops_total counter\n# TYPE willow_role_tx_reported_airtime_seconds_total counter\n# TYPE willow_modem_received_packets_total counter\n# TYPE willow_modem_sent_packets_total counter\n# TYPE willow_modem_errors_total counter\n# TYPE willow_modem_noise_dbm gauge\n# TYPE willow_modem_rssi_dbm gauge\n# TYPE willow_modem_temperature_celsius gauge\n# TYPE willow_modem_battery_volts gauge\n";
    for role in ["bot", "repeater", "room", "observer", "companion", "bot_companion"] {
        let labels = f"\{role=\"{role}\"\}";
        if let .Some(value) = field(status, role) {
            let available = value.type_of() == json.Kind.Object && field(value, "health_error").is_none();
            out += sample("willow_role_health_available", labels, if available { 1.0 } else { 0.0 });
            if available {
                if role == "bot" { out += packet_reports(value); }
                var off = false;
                if let .Some(item) = field(value, "state") {
                    if let .Ok(text) = item.get_string() { off = text == "disabled"; }
                }
                if !off { if let .Some(failures) = field(ready, "not_ready") {
                    let failure = field(failures, role);
                    var known = true;
                    if let .Some(error) = failure {
                        if let .Ok(text) = error.get_string() {
                            known = text != "health_connection_unavailable" && text != "health_response_invalid";
                        }
                    }
                    if known { out += sample("willow_role_ready", labels, if failure.is_none() { 1.0 } else { 0.0 }); }
                } }
                if let .Some(state) = field(value, "state") {
                    if let .Ok(text) = state.get_string() { out += sample("willow_role_running", labels, if text == "running" { 1.0 } else { 0.0 }); }
                }
                out += boolean("willow_radio_connected", labels, flag(value, "radio_connected"));
                out += boolean("willow_companion_listener_active", labels, flag(value, "listener_active"));
                out += boolean("willow_observer_mqtt_connected", labels, flag(value, "mqtt_connected"));
                if let .Some(stats) = field(value, "observer_stats") {
                    for key in ["observed", "published", "dropped"] { out += numeric(f"willow_observer_{key}_total", labels, stats, key, 1.0); }
                    out += numeric("willow_observer_queued", labels, stats, "queued", 1.0);
                    out += boolean("willow_observer_pending", labels, flag(stats, "pending"));
                    out += boolean("willow_observer_dirty", labels, flag(stats, "dirty"));
                    out += boolean("willow_observer_saving", labels, flag(stats, "saving"));
                    out += numeric("willow_observer_save_failures_total", labels, stats, "save_failures", 1.0);
                    out += numeric("willow_observer_save_error", labels, stats, "save_error", 1.0);
                    out += numeric("willow_observer_restored", labels, stats, "restored", 1.0);
                    out += numeric("willow_observer_expired_total", labels, stats, "expired", 1.0);
                }
                if let .Some(tx) = field(value, "role_tx") {
                    if enabled(tx, "available") {
                        for key in ["accepted", "succeeded", "failed", "rejected", "unknown", "diagnostic_drops"] { out += numeric(f"willow_role_tx_{key}_total", labels, tx, key, 1.0); }
                        out += numeric("willow_role_tx_reported_airtime_seconds_total", labels, tx, "reported_rf_airtime_ns", 0.000000001);
                    }
                }
                // The modem is shared. Export physical counters once, never sum role copies.
                if role == "repeater" {
                    if let .Some(t) = field(value, "telemetry") {
                        if enabled(t, "has_counters") {
                            if let .Some(c) = field(t, "counters") {
                                out += numeric("willow_modem_received_packets_total", "", c, "PacketsRecv", 1.0);
                                out += numeric("willow_modem_sent_packets_total", "", c, "PacketsSent", 1.0);
                                out += numeric("willow_modem_errors_total", "", c, "PacketsErrors", 1.0);
                            }
                        }
                        if enabled(t, "has_noise_floor") { out += numeric("willow_modem_noise_dbm", "", t, "noise_floor_dbm", 1.0); }
                        if enabled(t, "has_current_rssi") { out += numeric("willow_modem_rssi_dbm", "", t, "current_rssi_dbm", 1.0); }
                        if enabled(t, "has_mcu_temperature") { out += numeric("willow_modem_temperature_celsius", "", t, "mcu_temperature_c", 1.0); }
                        if enabled(t, "has_battery") { out += numeric("willow_modem_battery_volts", "", t, "battery_mv", 0.001); }
                    }
                }
            }
        }
    }
    out
}
