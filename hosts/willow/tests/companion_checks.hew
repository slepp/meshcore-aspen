import willow.src.companion;

import willow.src.companion_radio;

import willow.src.meshproto.companion_policy as policy;

import std.encoding.json;

import std.os;

import std.io;

import std.encoding.hex;

import std.string;

fn main() {
    let args = os.args();
    assert(args.len() == 3);
    let base = companion.open(args[1], hex.decode(args[2]).expect("valid hexadecimal")).expect("open companion");
    let radio = companion_radio.create(base);
    while let .Some(line) = (io.read_line() handle failure { panic(f"stdin read failed: {failure}"); }) {
        let words = line.trim().split(" ");
        if words.is_empty() {
            continue;
        }
        match words[0] {
            "DELAY" => {
                let sf = words[1].to_int().expect("spreading factor");
                radio.set_spreading(sf).expect("shared spreading factor");
                let prefs = json.parse("{\"rxdelay\":" + words[5] + "}").expect("receive preferences");
                println(policy.receive_delay(prefs, words[2].to_float().expect("snr"), sf, words[3].to_int().expect("packet size"), words[4].to_int().expect("airtime")));
            }
            "CONNECT" => println(f"CONNECTED {base.connect(words[1].to_int().expect("client")).expect("connect")}"),
            "DISCONNECT" => {
                base.disconnect(words[1].to_int().expect("client")).expect("disconnect");
                println("DISCONNECTED");
            }
            "CMD" => {
                for event in base.command(words[1].to_int().expect("client"), hex.decode(words[2]).expect("valid hexadecimal"), words[3].to_int().expect("time")).expect("command") {
                    println(f"FRAME {event.client} {hex.encode(event.frame)}");
                }
                println("END");
            }
            "JOURNAL" => {
                for event in base.journal(hex.decode(words[1]).expect("valid hexadecimal"), bytes.new(), 0).expect("journal") {
                    println(f"FRAME {event.client} {hex.encode(event.frame)}");
                }
                println("END");
            }
            "SEND" => {
                let client = words[1].to_int().expect("client");
                let plan = radio.prepare(client, hex.decode(words[2]).expect("valid hexadecimal"), words[3].to_int().expect("wall time"), words[4].to_int().expect("monotonic")).expect("prepare");
                if !plan.raw.is_empty() {
                    println(f"TX {plan.priority} {plan.delay} {hex.encode(plan.raw)}");
                    if words[5] == "1" {
                        radio.transmitted(plan.raw).expect("origin dedup");
                    }
                }
                for event in radio.admitted(plan, words[5] == "1", words[4].to_int().expect("monotonic")).expect("admission") {
                    println(f"FRAME {event.client} {hex.encode(event.frame)}");
                }
                println("END");
            }
            "RX" => {
                let batch = radio.receive_packet(hex.decode(words[1]).expect("valid hexadecimal"), words[2].to_int().expect("snr"), words[3].to_int().expect("rssi"), words[4].to_int().expect("wall"), words[5].to_int().expect("monotonic")).expect("RF ingress");
                for tx in batch.transmissions {
                    println(f"TX {tx.priority} {tx.delay} {hex.encode(tx.raw)}");
                }
                for event in batch.events {
                    println(f"FRAME {event.client} {hex.encode(event.frame)}");
                }
                println("END");
            }
            "SNAPSHOT" => println(base.snapshot().expect("snapshot")),
            "STOP" => {
                assert(base.shutdown().expect("shutdown"));
                break;
            }
            _ => panic("unknown checker command"),
        }
    }
}
