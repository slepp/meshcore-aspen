{
  "__inputs": [
    {"name": "DS_VM", "label": "VictoriaMetrics (Prometheus)", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "id": null,
  "uid": "meshcore-repeaters-vm",
  "title": "MeshCore · remote repeaters",
  "description": "Remote repeater status collected over RF by an on-device Lua monitor and published through the shared modem's native HTTPS telemetry service.",
  "tags": ["meshcore", "repeaters", "victoriametrics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "annotations": {"list": []},
  "links": [
    {"title": "Fleet, radios and bots", "type": "link", "url": "/d/meshcore-fleet-vm", "keepTime": true, "includeVars": true}
  ],
  "panels": [
    {
      "id": 1, "type": "text", "title": "Monitor and radio setup",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
      "options": {"mode": "markdown", "content": "Select the **Monitor device** and **Remote repeater**. The monitor uses authenticated read-only native status requests. Stock 1.17.1 supplies voltage when supported, uptime, queue, packet counters, airtime and its last received RSSI/SNR/noise. Battery percentage is not calculated.\n\n**Frequency mismatch** sends no RF request: the target and shared modem must use the same PHY. Aspen remains on 912.525 MHz; targets configured for 910.525 MHz remain fenced until an operator chooses a compatible setup.\n\nThe publisher rotates up to three peers per 60-second report. Remote polls normally run every 300 seconds. Check both **report age** and **RF sample age**; cached status is not a new RF response. Live panels suppress reports older than 360 seconds. Graphs retain history and gaps. Rates require multiple remote polls; zero and missing data are different."}
    },
    {
      "id": 2, "type": "stat", "title": "Remote report age",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 4, "w": 8, "h": 6},
      "targets": [
        {"refId": "A", "expr": "time() - tlast_over_time(meshcore_repeater_available{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$history])", "legendFormat": "{{device}} / {{peer}}", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "noValue": "No report", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 240}, {"color": "red", "value": 360}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": true}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 3, "type": "stat", "title": "RF sample age",
      "description": "Cached age at publication plus elapsed time since that report. Absent until the first successful RF response; no extrapolated remote uptime.",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 8, "y": 4, "w": 8, "h": 6},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_sample_age_seconds{device=~\"${device:regex}\",peer=~\"${peer:regex}\"} + time() - timestamp(meshcore_repeater_sample_age_seconds{device=~\"${device:regex}\",peer=~\"${peer:regex}\"})", "legendFormat": "{{device}} / {{peer}}", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "noValue": "No RF sample"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": true}, "graphMode": "none"}
    },
    {
      "id": 4, "type": "stat", "title": "Monitor result",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 16, "y": 4, "w": 8, "h": 6},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_error_code{device=~\"${device:regex}\",peer=~\"${peer:regex}\"} and (time() - timestamp(meshcore_repeater_error_code{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}) < 360)", "legendFormat": "{{device}} / {{peer}}", "instant": true}
      ],
      "fieldConfig": {"defaults": {"noValue": "No current report", "mappings": [{"type": "value", "options": {
        "0": {"text": "OK", "color": "green"},
        "1": {"text": "No RF sample", "color": "yellow"},
        "2": {"text": "Disabled", "color": "yellow"},
        "3": {"text": "Not due", "color": "yellow"},
        "4": {"text": "Radio busy", "color": "yellow"},
        "5": {"text": "Clock unavailable", "color": "red"},
        "6": {"text": "Capacity exhausted", "color": "red"},
        "7": {"text": "RF response timeout", "color": "red"},
        "8": {"text": "Malformed response", "color": "red"},
        "9": {"text": "Cancelled", "color": "yellow"},
        "10": {"text": "Permission required", "color": "red"},
        "11": {"text": "Transmission failed", "color": "red"},
        "12": {"text": "Frequency mismatch", "color": "yellow"}
      }}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": true}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 5, "type": "stat", "title": "Current battery voltage",
      "description": "Supported voltage only, gated by native fresh state and a report received within 360 seconds. No battery percentage or assumed discharge curve.",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 6},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_battery_volts{device=~\"${device:regex}\",peer=~\"${peer:regex}\"} and (meshcore_repeater_fresh{device=~\"${device:regex}\",peer=~\"${peer:regex}\"} == 1) and (time() - timestamp(meshcore_repeater_fresh{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}) < 360)", "legendFormat": "{{device}} / {{peer}}", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "volt", "decimals": 3, "noValue": "No fresh voltage"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": true}, "graphMode": "none"}
    },
    {
      "id": 6, "type": "timeseries", "title": "Battery voltage history",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 6},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_battery_volts{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "volt", "decimals": 3, "custom": {"spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "Sample availability and freshness",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_available{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · available"},
        {"refId": "B", "expr": "meshcore_repeater_fresh{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · fresh"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "decimals": 0, "custom": {"spanNulls": false, "lineInterpolation": "stepAfter"}}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "Returned uptime",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_uptime_seconds{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Repeater receive signal and noise",
      "description": "Remote radio's last received packet and noise floor, not the monitor's reception of the reply or a directed-link probe.",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_last_rssi_dbm{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · RSSI"},
        {"refId": "B", "expr": "meshcore_repeater_noise_dbm{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · noise"}
      ],
      "fieldConfig": {"defaults": {"unit": "dBm", "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 10, "type": "timeseries", "title": "Repeater last received SNR",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_last_snr_db{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "dB", "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 11, "type": "timeseries", "title": "Packet counters",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "{__name__=~\"meshcore_repeater_(rx_packets|tx_packets|rx_flood|rx_direct|tx_flood|tx_direct)_total\",device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · {{__name__}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 12, "type": "timeseries", "title": "Packet rates",
      "description": "Reset-aware rates of remote counters. Five-minute minimum step gives a rate window spanning at least four normal polls; cached exports do not represent additional RF polls.",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "rate(meshcore_repeater_rx_packets_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · RX packets", "interval": "300s"},
        {"refId": "B", "expr": "rate(meshcore_repeater_tx_packets_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · TX packets", "interval": "300s"},
        {"refId": "C", "expr": "rate(meshcore_repeater_rx_flood_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · RX flood", "interval": "300s"},
        {"refId": "D", "expr": "rate(meshcore_repeater_rx_direct_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · RX direct", "interval": "300s"},
        {"refId": "E", "expr": "rate(meshcore_repeater_tx_flood_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · TX flood", "interval": "300s"},
        {"refId": "F", "expr": "rate(meshcore_repeater_tx_direct_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · TX direct", "interval": "300s"}
      ],
      "fieldConfig": {"defaults": {"unit": "pps", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 13, "type": "timeseries", "title": "Duplicates and receive errors",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 40, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "{__name__=~\"meshcore_repeater_(direct_duplicates|flood_duplicates|rx_errors)_total\",device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · {{__name__}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 14, "type": "timeseries", "title": "Duplicate and receive error rates",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 40, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "rate(meshcore_repeater_direct_duplicates_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · direct duplicates", "interval": "300s"},
        {"refId": "B", "expr": "rate(meshcore_repeater_flood_duplicates_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · flood duplicates", "interval": "300s"},
        {"refId": "C", "expr": "rate(meshcore_repeater_rx_errors_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · RX errors", "interval": "300s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 15, "type": "timeseries", "title": "Returned TX and RX airtime",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 48, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_tx_airtime_seconds_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · TX"},
        {"refId": "B", "expr": "meshcore_repeater_rx_airtime_seconds_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · RX"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 16, "type": "timeseries", "title": "TX and RX airtime fraction",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 48, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "rate(meshcore_repeater_tx_airtime_seconds_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · TX", "interval": "300s"},
        {"refId": "B", "expr": "rate(meshcore_repeater_rx_airtime_seconds_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · RX", "interval": "300s"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 17, "type": "timeseries", "title": "Remote transmit queue",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_queued_packets{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 18, "type": "timeseries", "title": "Returned error flags",
      "description": "Raw firmware status flags, not a monotonic counter or monitor error code.",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_error_flags{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}}"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0, "custom": {"spanNulls": false, "lineInterpolation": "stepAfter"}}, "overrides": []}
    },
    {
      "id": 19, "type": "timeseries", "title": "Monitor request attempts and failures",
      "description": "Local monitor counters, not the remote radio's packet counters. Frequency-fenced targets send no requests.",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 0, "y": 64, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "meshcore_repeater_attempts_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · attempts"},
        {"refId": "B", "expr": "meshcore_repeater_failures_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}", "legendFormat": "{{device}} / {{peer}} · failures"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    },
    {
      "id": 20, "type": "timeseries", "title": "Monitor request and failure rates",
      "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
      "gridPos": {"x": 12, "y": 64, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "rate(meshcore_repeater_attempts_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · attempts", "interval": "300s"},
        {"refId": "B", "expr": "rate(meshcore_repeater_failures_total{device=~\"${device:regex}\",peer=~\"${peer:regex}\"}[$__rate_interval])", "legendFormat": "{{device}} / {{peer}} · failures", "interval": "300s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "custom": {"spanNulls": false}}, "overrides": []}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "device", "label": "Monitor device", "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
        "query": {"query": "label_values(meshcore_repeater_available, device)", "refId": "StandardVariableQuery"},
        "definition": "label_values(meshcore_repeater_available, device)",
        "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"}, "options": []
      },
      {
        "name": "peer", "label": "Remote repeater", "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_VM}"},
        "query": {"query": "label_values(meshcore_repeater_available{device=~\"${device:regex}\"}, peer)", "refId": "StandardVariableQuery"},
        "definition": "label_values(meshcore_repeater_available{device=~\"${device:regex}\"}, peer)",
        "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"}, "options": []
      },
      {
        "name": "history", "label": "History (report age)", "type": "custom", "query": "24h,7d,30d",
        "current": {"selected": true, "text": "7d", "value": "7d"},
        "options": [{"text": "24h", "value": "24h", "selected": false}, {"text": "7d", "value": "7d", "selected": true}, {"text": "30d", "value": "30d", "selected": false}]
      }
    ]
  }
}
