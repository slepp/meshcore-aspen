    {
      "id": 14,
      "title": "Observer persistence state",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 7
      },
      "description": "Dirty means accepted changes await a save. Saving is current work. Save error: 0 none; -1 commit failed; -2 directory sync failed after rename; -3 restore invalid/unreadable. -4 means restoring a checkpoint.",
      "targets": [
        {
          "refId": "A",
          "expr": "willow_observer_dirty{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · dirty",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "B",
          "expr": "willow_observer_saving{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · saving",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "C",
          "expr": "willow_observer_save_error{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · save result",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No current sample",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "spanNulls": false,
            "lineWidth": 0
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Idle / clear",
                  "color": "green"
                },
                "1": {
                  "text": "Active",
                  "color": "blue"
                },
                "-1": {
                  "text": "Commit failed",
                  "color": "red"
                },
                "-2": {
                  "text": "Directory sync failed",
                  "color": "red"
                },
                "-3": {
                  "text": "Restore failed",
                  "color": "red"
                },
                "-4": {
                  "text": "Restoring",
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto"
      }
    },
