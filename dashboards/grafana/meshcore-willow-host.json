          "refId": "A",
          "expr": "willow_health_source_age_seconds{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
