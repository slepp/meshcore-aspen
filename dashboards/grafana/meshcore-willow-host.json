{
  "__inputs": [
    {
      "name": "DS_VM",
      "label": "VictoriaMetrics (Prometheus)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": "meshcore-willow-host-vm",
  "title": "MeshCore · Willow host",
  "description": "Native Hew host health, observer delivery, companion TX and shared-modem measurements.",
  "tags": [
    "meshcore",
    "willow",
    "victoriametrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Read this host view",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "description": "",
      "targets": [],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No current sample",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Select a **Willow host**. These metrics come from the native Hew dashboard, separate from Aspen and Python bot feeds. State timelines show sampled transitions; missing scrapes remain gaps. A failed health source reports unavailable and omits its measurements.\n\nObserver rates count MQTT PUBACK-confirmed publications, not RF delivery. Companion TX outcomes describe those roles. Physical modem traffic appears once for the shared radio. CPU/RSS and native-worker process counters are not exported by this endpoint; bot readiness reports the existing bot health boundary."
      }
    },
    {
      "id": 2,
      "title": "Collector connection",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "description": "Collector scrape result. No series means this job has no samples in the selected range.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No current sample",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "spanNulls": false,
            "lineWidth": 0
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable / down",
                  "color": "red"
                },
                "1": {
                  "text": "Available / up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto"
      }
    },
    {
      "id": 3,
      "title": "Health source availability",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "description": "A bounded refresh requests all six health sources together. Zero means that source failed; its old measurements are omitted.",
      "targets": [
        {
          "refId": "A",
          "expr": "willow_health_source_available{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{source}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No current sample",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "spanNulls": false,
            "lineWidth": 0
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable / down",
                  "color": "red"
                },
                "1": {
                  "text": "Available / up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto"
      }
    },
    {
      "id": 4,
      "title": "Role readiness",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "description": "Reported operational readiness. Missing status/readiness is unknown, not ready. Bot readiness includes the existing native-worker health boundary.",
      "targets": [
        {
          "refId": "A",
          "expr": "willow_role_ready{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No current sample",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "spanNulls": false,
            "lineWidth": 0
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable / down",
                  "color": "red"
                },
                "1": {
                  "text": "Available / up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
