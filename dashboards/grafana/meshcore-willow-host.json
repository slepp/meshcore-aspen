    {
      "id": 7,
      "title": "Observer admissions, publications and drops",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "description": "Reset-aware rates; publications advance only on broker PUBACK. Dropped is actual outbox admission loss, not an absent sample.",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(willow_observer_observed_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · observed",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "B",
          "expr": "rate(willow_observer_published_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · published",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "C",
          "expr": "rate(willow_observer_dropped_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · dropped",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No current sample",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Observer backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "description": "Queued observations and the separate pending record awaiting PUBACK. Both contribute to the outstanding backlog.",
      "targets": [
        {
          "refId": "A",
          "expr": "willow_observer_queued{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · queued",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "B",
          "expr": "willow_observer_pending{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · pending PUBACK",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No current sample",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
