    {
      "id": 9,
      "title": "Companion TX outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "description": "Role-scoped outcomes. Accepted is admission; unknown is an uncertain send. Counter restarts use rate() reset handling.",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(willow_role_tx_accepted_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · accepted",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "B",
          "expr": "rate(willow_role_tx_succeeded_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · succeeded",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "C",
          "expr": "rate(willow_role_tx_failed_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · failed",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "D",
          "expr": "rate(willow_role_tx_rejected_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · rejected",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        },
        {
          "refId": "E",
          "expr": "rate(willow_role_tx_unknown_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · {{role}} · unknown",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No current sample",
