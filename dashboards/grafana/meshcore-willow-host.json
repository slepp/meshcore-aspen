          "refId": "C",
          "expr": "rate(willow_modem_errors_total{job=\"meshcore-willow\",instance=~\"${instance:regex}\"}[$__rate_interval]) and on(job,instance) (up{job=\"meshcore-willow\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "{{instance}} · errors",
