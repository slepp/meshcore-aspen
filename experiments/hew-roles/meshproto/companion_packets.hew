//! Companion packet construction without transport or application state.
import meshproto.companion_state as state;

import std.encoding.json;

import std.crypto.crypto;

import wire;

import companion;

pub fn flood(packet: wire.Packet, doc: json.Value, client: Option<companion.Client>) -> wire.Packet {
    var p = packet;
    p.route = 1;
    p.pathlen = state.integer(state.field(doc, "Preferences"), "path_hash_mode") << 6;
    p.path = bytes.new();
    var scope_key = state.blob(state.field(state.field(state.field(doc, "Preferences"), "default_scope"), "key"));
    if let .Some(c) = client {
        if c.unscoped {
            scope_key = bytes.new();
        } else if c.scope_key.len() == 16 {
            scope_key = c.scope_key;
        }
    }
    if scope_key.len() == 16 && !wire.equal(scope_key, state.padded(bytes.new(), 16)) {
        p.route = 0;
        p.code1 = wire.region_code(scope_key, p);
        p.code2 = 0;
    }
    p
}

pub fn routed(packet: wire.Packet, contact: json.Value, doc: json.Value, client: Option<companion.Client>, force_flood: bool) -> wire.Packet {
    let encoded = state.integer(contact, "OutPathLen");
    if !force_flood && encoded != 255 {
        var p = packet;
        p.route = 2;
        p.pathlen = encoded;
        p.path = wire.cut(state.blob(state.field(contact, "OutPath")), 0, state.path_size(encoded));
        p
    } else {
        flood(packet, doc, client)
    }
}

pub fn encrypted(key: bytes, peer: bytes, kind: i64, plain: bytes, anonymous: bool) -> wire.Packet {
    var prefix = wire.cut(peer, 0, 1);
    prefix.append(if anonymous {
        wire.public_key(key)
    } else {
        wire.cut(wire.public_key(key), 0, 1)
    });
    wire.packet(1, kind, wire.cat(prefix, wire.seal(wire.shared(key, peer), plain)))
}

pub fn priority(p: wire.Packet) -> i64 {
    if p.route == 0 || p.route == 1 {
        if p.kind == 8 {
            2
        } else if p.kind == 4 {
            3
        } else {
            1
        }
    } else {
        if p.kind == 9 {
            5
        } else if p.kind == 8 {
            1
        } else {
            0
        }
    }
}

pub fn timeout(p: wire.Packet, airtime: i64) -> i64 {
    if p.route == 0 || p.route == 1 {
        500 + 16 * airtime
    } else {
        500 + (6 * airtime + 250) * ((p.pathlen & 63) + 1)
    }
}

pub fn sent(p: wire.Packet, tag: i64, airtime: i64) -> bytes {
    wire.cat(wire.cat(wire.byte(6), wire.byte(if p.route == 0 || p.route == 1 {
        1
    } else {
        0
    })), wire.cat(wire.le(tag, 4), wire.le(timeout(p, airtime), 4)))
}

pub fn channel(doc: json.Value, index: i64) -> Option<json.Value> {
    if index < 0 || index >= 40 {
        return .None;
    }
    let ch = state.item(state.field(doc, "Channels"), index);
    if ch.type_of() == json.Kind.Null || state.text(ch, "Name").is_empty() {
        .None
    } else {
        .Some(ch)
    }
}

pub fn hash(channel: json.Value) -> i64 {
    crypto.sha256(state.blob(state.field(channel, "PSK")))[0] as i64
}

pub fn reply_flood(packet: wire.Packet, received: wire.Packet, doc: json.Value) -> wire.Packet {
    var output = flood(packet, doc, .None);
    let prefs = state.field(doc, "Preferences");
    var scope_key = state.blob(state.field(state.field(prefs, "default_scope"), "key"));
    if received.route == 1 && state.integer(prefs, "wildcard_flags") & 1 == 0 {
        scope_key = bytes.new();
    } else if received.route == 0 {
        let regions = state.field(prefs, "regions");
        var matched = false;
        for i in 0..state.count(regions) {
            let region = state.item(regions, i);
            if matched || state.integer(region, "flags") & 1 != 0 {
                continue;
            }
            let name = state.text(region, "name");
            var keys = json.array();
            if name.starts_with("$") {
                keys = state.field(region, "keys");
            } else {
                let scoped_name = if name.starts_with("#") {
                    name
                } else {
                    "#" + name
                };
                keys.push(state.array(wire.cut(crypto.sha256(scoped_name.to_bytes()), 0, 16))).expect("region key");
            }
            for j in 0..state.count(keys) {
                let key = state.blob(state.item(keys, j));
                if key.len() == 16 && wire.region_code(key, received) == received.code1 {
                    scope_key = state.blob(state.item(keys, 0));
                    matched = true;
                    break;
                }
            }
        }
    }
    if scope_key.len() == 16 && !wire.equal(scope_key, state.padded(bytes.new(), 16)) {
        output.route = 0;
        output.code1 = wire.region_code(scope_key, output);
        output.code2 = 0;
    } else {
        output.route = 1;
        output.code1 = 0;
        output.code2 = 0;
    }
    output
}
