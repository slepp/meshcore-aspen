import observer_queue;
import meshproto.observation;
import meshproto.observer_auth;
import meshproto.mqtt_endpoint;
import hostlib.binary;
import hostlib.mqtt;
import hostlib.outbound;
import hostlib.events;
import hostlib.deadline;
import std.encoding.hex;
import wire;

extern "C" {
    fn mc_supervision_testing() -> i32;
}

pub type Plan {
    outbox: ChildRef<observer_queue.Outbox>;
    config: observation.Config;
    url: string;
    ca_file: string;
    client_id: string;
    username: string;
    password: bytes;
    audience: string;
    seed: bytes;
}

pub enum Phase {
    Waiting;
    Connecting;
    ConnAck;
    OnlineAck;
    Ready;
    PacketAck;
    OfflineAck;
    Disconnecting;
    Stopped;
    Quarantined;
}

impl Display for Phase {
    fn fmt(self) -> string {
        match self {
            Phase.Waiting => "waiting",
            Phase.Connecting => "connecting",
            Phase.ConnAck => "connack",
            Phase.OnlineAck => "online-ack",
            Phase.Ready => "ready",
            Phase.PacketAck => "packet-ack",
            Phase.OfflineAck => "offline-ack",
            Phase.Disconnecting => "disconnecting",
            Phase.Stopped => "stopped",
            Phase.Quarantined => "quarantined",
        }
    }
}

pub type Snapshot {
    phase: Phase;
    epoch: i64;
    connected: bool;
    reason: string;
    writing: i64;
    awaiting_pong: bool;
}

type PendingWrite {
    outgoing: bytes;
    written: i64;
    deadline: i64;
}

type AuthenticationClock {
    issued: deadline.UTC;
    renew: deadline.UTC;
}

type ConnectionEpoch {
    phase: Phase;
    epoch: i64;
    connected: bool;
    reason: string;
    incarnation: string;
    token: string;
    identifier: i64;
    retry_at: i64;
    last_write: i64;
    ping_deadline: i64;
}

/// One nonblocking step per call. Admission has its own actor and cannot wait
/// behind DNS, a handshake, a socket write or a broker acknowledgement.
pub actor Publisher {
    let plan: Plan;
    var configured: bool = false;
    var topic: string = "";
    var transport_url: string = "";
    var client_id: string = "";
    var cycle: ConnectionEpoch = ConnectionEpoch { phase: .Waiting, epoch: 0,
        connected: false, reason: "", incarnation: "", token: "", identifier: 1,
        retry_at: 0, last_write: 0, ping_deadline: 0 };
    var connection: Option<outbound.Connection> = .None;
    var decoder: mqtt.Decoder = mqtt.decoder(4096).expect("control decoder");
    var write: PendingWrite = PendingWrite { outgoing: bytes.new(), written: 0, deadline: 0 };
    var authentication: AuthenticationClock = AuthenticationClock {
        issued: deadline.UTC { at: 0 }, renew: deadline.UTC { at: 0 } };
    var last_status_time: i64 = 0;
    var stopping: bool = false;
    var stop_deadline: i64 = 0;
    var event_group: Option<events.Group> = .None;
    var retirement: Option<events.Notify> = .None;
    var continuation_at: i64 = 9223372036854775807;
    var queued_work: bool = false;
    mailbox 16;

    receive fn wait(consume group: events.Group, now: i64, utc: i64) -> i64 {
        if event_group.is_none() {
            retirement = .Some(events.notify_on_drop(group));
            event_group = .Some(events.share(group));
        }
        var next: i64 = 9223372036854775807;
        if cycle.phase == Phase.Stopped || cycle.phase == Phase.Quarantined { return next; }
        if stopping { next = stop_deadline; }
        if cycle.phase == Phase.Waiting {
            if !stopping && cycle.retry_at < next { next = cycle.retry_at; }
            return next;
        }
        if cycle.phase != Phase.Ready && write.deadline < next { next = write.deadline; }
        if !write.outgoing.is_empty() && write.deadline < next { next = write.deadline; }
        if cycle.ping_deadline != 0 && cycle.ping_deadline < next { next = cycle.ping_deadline; }
        if cycle.phase == Phase.Ready && !stopping {
            if queued_work { next = now; }
            if cycle.ping_deadline == 0 && cycle.last_write + 10000 < next { next = cycle.last_write + 10000; }
        }
        if authentication.renew.at != 0 {
            let renewal = deadline.from_utc(authentication.renew, deadline.UTC { at: utc },
                deadline.Monotonic { at: now }).at;
            if renewal < next { next = renewal; }
        }
        if continuation_at < next { next = continuation_at; }
        let flags: i32 = if write.outgoing.is_empty() { 1 } else { 3 };
        let result = match connection {
            .Some(value) => outbound.watch(value, group, flags),
            .None => return next,
        };
        match result {
            .Ok(delay) => {
                if delay != 9223372036854775807 && now + delay < next { next = now + delay; }
            }
            .Err(error) => {
                fail(to_string(error), now);
                next = if stopping { now } else { cycle.retry_at };
            }
        }
        next
    }

    fn offline() {
        cycle.connected = false;
        let _ = plan.outbox.connection(false);
    }

    fn stop_connection() {
        connection = .None;
        write.outgoing = bytes.new();
        write.written = 0;
        cycle.ping_deadline = 0;
        cycle.token = "";
        offline();
    }

    fn fail(message: string, now: i64) {
        cycle.reason = message;
        stop_connection();
        decoder = mqtt.decoder(4096).expect("fresh control decoder");
        cycle.phase = if stopping { Phase.Stopped } else { Phase.Waiting };
        cycle.retry_at = now + 1000;
    }

    fn quarantine(message: string) {
        cycle.reason = message;
        stop_connection();
        cycle.phase = Phase.Quarantined;
    }

    fn configure() -> bool {
        if configured {
            return cycle.phase != Phase.Quarantined;
        }
        configured = true;
        transport_url = match mqtt_endpoint.parse(plan.url) {
            .Ok(value) => value.transport_url,
            .Err(error) => {
                quarantine(error);
                return false;
            }
        };
        topic = match observation.topic(plan.config) {
            .Ok(value) => value,
            .Err(error) => {
                quarantine(error);
                return false;
            }
        };
        client_id = if plan.client_id.is_empty() {
            "meshcore-observer-" + hex.encode(plan.config.identity).slice(0, 12)
        } else { plan.client_id };
        if !mqtt.text_valid(client_id) || !mqtt.text_valid(plan.username) || plan.password.len() > 65535 {
            quarantine("observer MQTT client identifier or credentials exceed wire limits");
            return false;
        }
        if !plan.audience.is_empty() &&
            (!observation.public_format(plan.config.format) || !plan.username.is_empty() ||
             !plan.password.is_empty() || (plan.seed.len() != 32 && plan.seed.len() != 64)) {
            quarantine("observer JWT requires a seed or expanded identity, observer/capture format and no static credentials");
            return false;
        }
        if !plan.audience.is_empty() && !wire.equal(wire.public_key(plan.seed), plan.config.identity) {
            quarantine("observer JWT key does not match the retained identity");
            return false;
        }
        true
    }

    fn status(state: string, utc: i64) -> Result<string, string> {
        if utc >= 1735689600000 {
            last_status_time = utc;
        }
        observation.status(plan.config, state, last_status_time)
    }

    fn queue_write(data: bytes, target: Phase, now: i64) {
        write.outgoing = data;
        write.written = 0;
        cycle.phase = target;
        write.deadline = now + (if stopping { 1000 } else { 3000 });
    }

    fn next_identifier() -> i64 {
        cycle.identifier = if cycle.identifier >= 65535 { 1 } else { cycle.identifier + 1 };
        cycle.identifier
    }

    fn publish_status(state: string, target: Phase, now: i64, utc: i64) {
        let body = match status(state, utc) {
            .Ok(value) => value.to_bytes(),
            .Err(error) => {
                fail(error, now);
                return;
            }
        };
        let frame = match mqtt.publish(topic + "/status", body, cycle.identifier, true) {
            .Ok(value) => value,
            .Err(error) => {
                fail(to_string(error), now);
                return;
            }
        };
        queue_write(frame, target, now);
    }

    fn begin(now: i64, utc: i64) {
        offline();
        if observation.public_format(plan.config.format) && utc < 1735689600000 {
            cycle.reason = "observer MQTT requires synchronized UTC";
            cycle.retry_at = now + 1000;
            return;
        }
        var username = plan.username;
        var password = plan.password;
        authentication.issued = deadline.UTC { at: 0 };
        authentication.renew = deadline.UTC { at: 0 };
        if !plan.audience.is_empty() {
            let input = match observer_auth.signing_input(plan.config.identity, plan.audience, utc / 1000) {
                .Ok(value) => value,
                .Err(error) => {
                    quarantine(error);
                    return;
                }
            };
            let signature = wire.signature(plan.seed, input.to_bytes());
            password = match observer_auth.finish(plan.config.identity, plan.audience, utc / 1000, signature) {
                .Ok(value) => value.to_bytes(),
                .Err(error) => {
                    quarantine(error);
                    return;
                }
            };
            username = observer_auth.username(plan.config.identity).expect("validated identity");
            authentication.issued = deadline.UTC { at: utc };
            authentication.renew = deadline.UTC { at: utc + 86100000 };
        }
        let will = match status("offline", utc) {
            .Ok(value) => value.to_bytes(),
            .Err(error) => {
                fail(error, now);
                return;
            }
        };
        write.outgoing = match mqtt.connect(client_id, username, password, topic + "/status", will, 10) {
            .Ok(value) => value,
            .Err(error) => {
                quarantine(to_string(error));
                return;
            }
        };
        connection = match outbound.start(transport_url, plan.ca_file) {
            .Ok(value) => .Some(value),
            .Err(error) => {
                fail(to_string(error), now);
                return;
            }
        };
        write.written = 0;
        cycle.identifier = 1;
        cycle.phase = Phase.Connecting;
        write.deadline = now + 3100;
        cycle.epoch += 1;
        cycle.reason = "";
    }

    fn received(packet: mqtt.Packet, now: i64, utc: i64) {
        let reply = match mqtt.reply(packet) {
            .Ok(value) => value,
            .Err(error) => {
                fail(to_string(error), now);
                return;
            }
        };
        match reply {
            mqtt.Reply.Connected => {
                if cycle.phase != Phase.ConnAck || !write.outgoing.is_empty() {
                    fail("unexpected MQTT CONNACK", now);
                    return;
                }
                publish_status("online", Phase.OnlineAck, now, utc);
            }
            mqtt.Reply.Rejected(code) => {
                fail(f"MQTT CONNACK rejected: code={code}", now);
            }
            mqtt.Reply.Acknowledged(id) => {
                if id != cycle.identifier || !write.outgoing.is_empty() {
                    return;
                }
                if cycle.phase == Phase.OnlineAck {
                    if !stopping {
                        cycle.connected = true;
                        let _ = plan.outbox.connection(true);
                    }
                    cycle.phase = Phase.Ready;
                } else if cycle.phase == Phase.PacketAck && !stopping {
                    match plan.outbox.acknowledge(cycle.token) {
                        .Ok(true) => {
                            cycle.token = "";
                            cycle.phase = Phase.Ready;
                        }
                        _ => fail("observer publication acknowledgement lost its queue incarnation", now),
                    }
                } else if cycle.phase == Phase.OfflineAck {
                    queue_write(mqtt.frame(224, bytes.new()).expect("DISCONNECT"), Phase.Disconnecting, now);
                }
            }
            mqtt.Reply.Pong => { cycle.ping_deadline = 0; }
        }
    }

    receive fn step(now: i64, utc: i64) {
        continuation_at = 9223372036854775807;
        queued_work = false;
        if !configure() || cycle.phase == Phase.Stopped {
            return;
        }
        if stopping && now >= stop_deadline {
            stop_connection();
            cycle.phase = Phase.Stopped;
            return;
        }
        let state = match plan.outbox.state() {
            .Ok(value) => value,
            .Err(_) => {
                fail("observer admission actor is unavailable", now);
                return;
            }
        };
        let current = state.incarnation;
        queued_work = state.work;
        if current.is_empty() {
            quarantine("observer admission configuration or entropy is unavailable");
            return;
        }
        if !stopping && state.closed {
            stop_connection();
            cycle.phase = Phase.Stopped;
            return;
        }
        if cycle.incarnation != current {
            if !cycle.incarnation.is_empty() {
                fail("observer admission actor was replaced", now);
            }
            cycle.incarnation = current;
        }
        if cycle.phase == Phase.Waiting {
            if !stopping && now >= cycle.retry_at {
                begin(now, utc);
            }
            return;
        }
        if !stopping && observation.public_format(plan.config.format) &&
            (utc < 1735689600000 || (authentication.issued.at != 0 && utc < authentication.issued.at) ||
             (authentication.renew.at != 0 && utc >= authentication.renew.at)) {
            fail("observer UTC or identity token requires reconnect", now);
            return;
        }
        if cycle.phase == Phase.Connecting {
            let ready = match connection {
                .Some(stream) => outbound.progress(stream),
                .None => .Err(outbound.TransportError.InvalidConfiguration),
            };
            match ready {
                .Ok(true) => {
                    cycle.phase = Phase.ConnAck;
                    write.deadline = now + 3000;
                }
                .Ok(false) => {
                    if now >= write.deadline {
                        fail("observer TCP/TLS connection deadline expired", now);
                    }
                    return;
                }
                .Err(error) => {
                    fail(to_string(error), now);
                    return;
                }
            }
        }
        for attempt in 0..8 {
            let input = match connection {
                .Some(stream) => outbound.read(stream),
                .None => return,
            };
            match input {
                outbound.Read.Idle => break,
                outbound.Read.End => {
                    fail("observer MQTT connection reached EOF", now);
                    return;
                }
                outbound.Read.Failed(error) => {
                    fail(to_string(error), now);
                    return;
                }
                outbound.Read.Data(data) => {
                    if attempt == 7 { continuation_at = now; }
                    let batch = mqtt.feed(decoder, data);
                    decoder = batch.decoder;
                    for packet in batch.packets {
                        received(packet, now, utc);
                        if cycle.phase == Phase.Waiting || cycle.phase == Phase.Stopped {
                            return;
                        }
                    }
                    if let .Some(error) = decoder.failure {
                        fail(to_string(error), now);
                        return;
                    }
                }
            }
        }
        if stopping && write.outgoing.is_empty() && cycle.phase != Phase.OfflineAck && cycle.phase != Phase.Disconnecting {
            let _ = next_identifier();
            publish_status("offline", Phase.OfflineAck, now, utc);
        }
        if !write.outgoing.is_empty() {
            if now >= write.deadline {
                fail(f"observer MQTT write deadline expired: committed_prefix={write.written}", now);
                return;
            }
            let end = if write.outgoing.len() - write.written > 65536 { write.written + 65536 } else { write.outgoing.len() };
            let suffix = binary.slice(write.outgoing, write.written, end).expect("MQTT write suffix");
            let result = match connection {
                .Some(stream) => outbound.write_some(stream, suffix),
                .None => return,
            };
            match result {
                .Ok(count) => {
                    write.written += count;
                    if write.written == write.outgoing.len() {
                        write.outgoing = bytes.new();
                        write.written = 0;
                        cycle.last_write = now;
                        if cycle.phase == Phase.Disconnecting {
                            stop_connection();
                            cycle.phase = Phase.Stopped;
                        }
                    }
                }
                .Err(error) => {
                    fail(f"{to_string(error)}; committed_prefix={write.written}", now);
                }
            }
            return;
        }
        if (cycle.phase == Phase.ConnAck || cycle.phase == Phase.OnlineAck || cycle.phase == Phase.PacketAck ||
            cycle.phase == Phase.OfflineAck) && now >= write.deadline {
            fail("observer MQTT acknowledgement deadline expired: " + to_string(cycle.phase), now);
            return;
        }
        if cycle.ping_deadline != 0 && now >= cycle.ping_deadline {
            fail("observer MQTT PINGRESP deadline expired", now);
            return;
        }
        if cycle.phase == Phase.Ready && !stopping {
            let next = match plan.outbox.next() {
                .Ok(value) => value,
                .Err(_) => {
                    fail("observer admission actor is unavailable", now);
                    return;
                }
            };
            if let .Some(delivery) = next {
                let id = next_identifier();
                let data = match mqtt.publish(topic + "/packets", delivery.payload, id, false) {
                    .Ok(value) => value,
                    .Err(error) => {
                        quarantine(to_string(error));
                        return;
                    }
                };
                cycle.token = delivery.token;
                queue_write(data, Phase.PacketAck, now);
            } else if cycle.ping_deadline == 0 && now - cycle.last_write >= 10000 {
                cycle.ping_deadline = now + 3000;
                queue_write(mqtt.frame(192, bytes.new()).expect("PINGREQ"), Phase.Ready, now);
            }
        }
    }

    receive fn snapshot() -> Snapshot {
        Snapshot { phase: cycle.phase, epoch: cycle.epoch, connected: cycle.connected, reason: cycle.reason,
            writing: write.outgoing.len() - write.written, awaiting_pong: cycle.ping_deadline != 0 }
    }

    receive fn inject_failure() {
        if unsafe { mc_supervision_testing() == 1 } {
            panic("injected observer publisher failure");
        }
    }

    receive fn shutdown(now: i64) {
        stopping = true;
        stop_deadline = now + 1000;
        let _ = plan.outbox.close();
        offline();
        if cycle.phase == Phase.Waiting || cycle.phase == Phase.Connecting || cycle.phase == Phase.ConnAck ||
            cycle.phase == Phase.Quarantined {
            stop_connection();
            cycle.phase = Phase.Stopped;
        }
        if let .Some(group) = event_group { events.wake(group).expect("wake observer publisher shutdown"); }
    }
}

pub supervisor PublisherBranch(plan: Plan) {
    strategy: one_for_one;
    intensity: 2 within 60s;
    child publisher: Publisher(plan: plan);
}
