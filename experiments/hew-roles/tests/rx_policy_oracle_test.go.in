package roles

import (
	"context"
	"encoding/hex"
	"encoding/json"
	"math"
	"os"
	"strconv"
	"testing"

	meshcore "github.com/meshcore-go/meshcore-go"
	"github.com/meshcore-go/meshcore-go/hardware"
	"meshcore.local/meshcore/internal/policy"
)

func TestWillowReceivePolicyOracle(t *testing.T) {
	input, output := os.Getenv("MESHCORE_RX_INPUT"), os.Getenv("MESHCORE_RX_OUTPUT")
	if input == "" || output == "" {
		t.Skip("isolated receive-policy differential paths required")
	}
	var cases struct {
		Delays []struct {
			Base, Score float32
			Airtime     uint32
		}
		Scores []struct {
			SNR    float64
			SF     uint8
			Length int
		}
		Commands []string
	}
	raw, err := os.ReadFile(input)
	if err != nil {
		t.Fatal(err)
	}
	if err := json.Unmarshal(raw, &cases); err != nil {
		t.Fatal(err)
	}
	var results struct {
		Delays   []string
		Scores   []string
		Commands []string
	}
	prefs := policy.Defaults(policy.Repeater)
	for _, test := range cases.Delays {
		prefs.RXDelay = test.Base
		delay, err := policy.RXDelayMillis(prefs, test.Score, test.Airtime)
		if err != nil {
			results.Delays = append(results.Delays, "ERROR "+err.Error())
		} else {
			hold := delay
			if hold < 50 {
				hold = 0
			} else if hold > 32000 {
				hold = 32000
			}
			results.Delays = append(results.Delays, fmtReceive(delay, hold))
		}
	}
	for _, test := range cases.Scores {
		bits := math.Float32bits(float32(hardware.PacketScore(test.SNR, test.SF, test.Length)))
		results.Scores = append(results.Scores, hex.EncodeToString([]byte{
			byte(bits), byte(bits >> 8), byte(bits >> 16), byte(bits >> 24)}))
	}
	service := &Service{id: fixedID(1), profile: policy.Repeater,
		state: diskState{Name: "Hew Room", Preferences: policy.Defaults(policy.Repeater)},
		cfg: Config{AirtimeEstimator: func(int) uint32 { return 100 },
			RXScore: func(*meshcore.Packet, int, uint32) (float32, error) { return 0, nil }}}
	service.state.Preferences.TXDelay = 0
	service.state.Preferences.DirectTXDelay = 0
	service.sourcePolicy = func(context.Context, float64) error { return nil }
	for _, command := range cases.Commands {
		reply, _, err := service.commandAt(0, command)
		if err != nil {
			t.Fatal(err)
		}
		results.Commands = append(results.Commands, reply)
	}
	raw, err = json.Marshal(results)
	if err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(output, raw, 0600); err != nil {
		t.Fatal(err)
	}
}

func fmtReceive(delay, hold int32) string {
	return strconv.FormatInt(int64(delay), 10) + " " + strconv.FormatInt(int64(hold), 10)
}
