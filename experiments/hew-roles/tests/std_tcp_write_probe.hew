import std.net;

import std.stream;

import std.os;

actor Writer {
    let input: stream.Stream<bytes>;
    let output: stream.Sink<bytes>;
    receive fn fill() {
        var data = bytes.new();
        for index in 0..65536 {
            data.push(7);
        }
        for attempt in 0..256 {
            if output.send(data).is_err() {
                println("STD_TCP_RETURNED_ERROR");
                return;
            }
        }
        panic("peer buffer did not fill");
    }
}

actor Healthy {
    receive fn ping() -> bool {
        true
    }
}

fn main() {
    let args = os.args();
    let connection = net.connect_timeout(args[1], 1, 0).expect("connect");
    connection.set_write_timeout(30).expect("write timeout");
    let (input, output) = connection.split();
    let writer = spawn Writer(input: input, output: output);
    let healthy = spawn Healthy();
    assert(writer.fill().is_err());
    assert(healthy.ping().expect("healthy actor"));
    println("STD_TCP_TIMEOUT_IS_ACTOR_FAILURE");
}
